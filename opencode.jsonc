{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Broad baseline: every shell command prompts unless overridden.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Read-only git inspection — allow.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git remote *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },

    // Safe workflow commands — allow.
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    // Branch checkout: only literal `git checkout <branch>` and `git checkout -b ...`.
    // `git checkout -- <path>` is intentionally NOT allowed here.
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git merge *", "effect": "allow" },
    { "action": "shell", "resource": "git pull *", "effect": "allow" },

    // Rebase rewrites history — ask before letting it run.
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },

    // Destructive git operations — deny outright.
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean -f*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "git restore *", "effect": "deny" },
    { "action": "shell", "resource": "git stash drop *", "effect": "deny" },
    { "action": "shell", "resource": "git stash clear *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D *", "effect": "deny" },
    { "action": "shell", "resource": "git branch --delete --force *", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d *", "effect": "deny" },
    { "action": "shell", "resource": "git tag --delete *", "effect": "deny" },
    { "action": "shell", "resource": "git rm *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-repo *", "effect": "deny" },

    // Raw filesystem destruction — deny outright.
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
  ],
}
